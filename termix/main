#!/usr/bin/env bash
source "$REPO_PATH/lib.sh"

say "Installing termix"

if is_macos; then
  # the release ships a homebrew cask, which picks the matching disk image
  cask_install "https://github.com/Termix-SSH/termix/releases/latest/download/termix.rb"
  exit 0
fi

apt_install_deb https://github.com/Termix-SSH/Termix/releases/latest/download/termix_linux_x64_deb.deb
